# ============================================================
# Inkstone — example configuration
# Copy this file to .env and fill in your values. Ordinary users only need to edit the first line to get started.
# ============================================================

# [REQUIRED] Agnes API Key (Free Access tier: positioned by the official provider as personal/testing/demos, subject to fair-use quotas; no permanent-free guarantee)
# Put the key in this file (repo-root .env) or export it in the environment.
# scripts/start.sh and the Web UI loader read KEY=value lines; they do not read .agnes_config/.
# Note: the Free Access tier is subject to fair-use quota limits; high-frequency or production use requires applying for a Token Plan or switching PROVIDER (see below)
AGNES_API_KEY=sk-your-agnes-key

# Text / tool-calling model (default: agnes-3.0-flash; https://agnes-ai.com/en/docs/agnes-30-flash)
# AGNES_CHAT_MODEL=agnes-3.0-flash
# API root (default: https://apihub.agnes-ai.com/v1). Set a mirror only if that host is unreachable.
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Call-rate protection — Agnes Free/Default RPM (× 0.8 safety factor in code):
#   Text 20 | Image 1K 20 | Image 2K 10 | Image 3K/4K 1
# AGNES_RATE_LIMIT=20          # text + image 1K ceiling
# AGNES_IMAGE_2K_RPM=10
# AGNES_IMAGE_3K_RPM=1

# Image-to-image model (used for character consistency; defaults to the same model as text-to-image, agnes-image-2.5-flash; can fall back to 2.1)
# AGNES_IMAGE_I2I_MODEL=agnes-image-2.1-flash

# ------------------------------------------------------------
# [OPTIONAL] Switch image Provider to hedge against Agnes single-point dependency (whitepaper ADR-12.1)
# Leave PROVIDER empty by default = agnes; only fill in the four fields below if you want to use any OpenAI-compatible image endpoint.
# ------------------------------------------------------------
# PROVIDER=agnes                          # agnes | openai_compat
# OPENAI_COMPAT_BASE_URL=https://.../v1
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_MODEL_T2I=...            # e.g. gemini-2.0-flash-exp-image-generation
# OPENAI_COMPAT_MODEL_I2I=...

# ------------------------------------------------------------
# [OPTIONAL] Unattended long-novel supervisor (auto-retry timeouts / 503)
# ------------------------------------------------------------
# INKSTONE_RUN_DEADLINE_HOURS=24         # wall-clock pause after this many hours; same project_id resumes
# INKSTONE_SUPERVISOR_BACKOFF_BASE=30    # seconds between pipeline attempts after transient failure
# INKSTONE_SUPERVISOR_BACKOFF_CAP=300    # max sleep between attempts

# ------------------------------------------------------------
# [OPTIONAL] Web UI bind. Loopback is the default and needs nothing else.
# A non-loopback host refuses to start until all three of these are set.
# ------------------------------------------------------------
# INKSTONE_UI_HOST=127.0.0.1
# INKSTONE_UI_PORT=8000
# INKSTONE_UI_ALLOW_LAN=1
# INKSTONE_UI_TOKEN=replace-with-a-long-random-token
# INKSTONE_UI_ORIGIN=http://192.168.1.5:8000
# Comma-separated https hosts allowed for provider image downloads.
# Empty means any public https host. Private and metadata addresses stay blocked.
# INKSTONE_IMAGE_DOWNLOAD_HOSTS=cdn.example
